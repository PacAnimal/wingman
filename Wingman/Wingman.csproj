<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseRidGraph>true</UseRidGraph>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win10-x64</RuntimeIdentifier>
        <ApplicationIcon>..\Graphics\Wingman.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>OPENAI001;ANTHROPIC001</NoWarn>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="..\Graphics\Wingman.ico" Link="Wingman.ico" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Cathedral" Version="0.0.412" />
      <PackageReference Include="Markdig" Version="1.1.1" />
      <PackageReference Include="Mime" Version="3.8.0" />
      <PackageReference Include="Microsoft.Extensions.AI" Version="10.3.0" />
      <PackageReference Include="Anthropic" Version="12.8.0" />
      <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
      <!-- GeneratePathProperty gives us $(PkgCI_Microsoft_Windows_Console_ConPTY) for manual import below.
           The package's .targets file is misnamed (missing the CI. prefix) so NuGet never auto-imports it. -->
      <PackageReference Include="CI.Microsoft.Windows.Console.ConPTY" Version="1.22.250314001" GeneratePathProperty="true" />
      <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.36" />
    </ItemGroup>

    <!-- fix: manually import the misnamed ConPTY build files -->
    <Import Project="$(PkgCI_Microsoft_Windows_Console_ConPTY)\build\Microsoft.Windows.Console.ConPTY.props" />
    <Import Project="$(PkgCI_Microsoft_Windows_Console_ConPTY)\build\Microsoft.Windows.Console.ConPTY.targets" />

    <Target Name="CleanPublishOutput" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <!-- terminal control ships its own pdb; OpenConsole.exe is not needed (we use conpty.dll directly) -->
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'OpenConsole'" />
        </ItemGroup>
    </Target>

</Project>
