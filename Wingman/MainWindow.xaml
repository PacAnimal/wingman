<Window x:Class="Wingman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wingman"
        mc:Ignorable="d"
        Title="Wingman" Icon="pack://application:,,,/Wingman.ico" Height="600" Width="1400"
        Background="#1E1E1E" Padding="0">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="4"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="OuterGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:TabBar x:Name="TabBar" Grid.Row="0" />

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="250" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="GridSplitter" Grid.Column="1" Width="3"
                          HorizontalAlignment="Stretch" Focusable="False"
                          Background="#333333"
                          PreviewMouseDown="GridSplitter_PreviewMouseDown"
                          PreviewMouseUp="GridSplitter_PreviewMouseUp" />
        </Grid>
    </Grid>
</Window>
