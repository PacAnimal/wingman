<UserControl x:Class="Wingman.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Background="#252526">
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#CCCCCC" FontSize="13" />
            <Button x:Name="ResetButton" Content="Reset" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    Focusable="False"
                    Foreground="#AAAAAA" Cursor="Hand" Padding="6,3"
                    Click="ResetButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- messages -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer"
                      Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MessagesPanel" Margin="0,4,0,4" />
        </ScrollViewer>

        <!-- input -->
        <Border Grid.Row="2" Background="#252526" Padding="8">
            <TextBox x:Name="InputBox"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="120" MinHeight="24"
                     Background="#3C3C3C" Foreground="#CCCCCC"
                     CaretBrush="#CCCCCC" SelectionBrush="#0E639C"
                     FocusVisualStyle="{x:Null}" Padding="6,4"
                     BorderThickness="1"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13"
                     PreviewKeyDown="InputBox_PreviewKeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4A6785" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Border>

        <!-- disabled overlay when no API key -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DisabledOverlay"
              Visibility="Collapsed" Background="#CC1E1E1E">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#888888" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="20" FontSize="13">
                No OPENAI_API_KEY set.&#x0a;AI chat is unavailable.
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
