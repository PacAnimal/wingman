<UserControl x:Class="Wingman.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Background="#252526">
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#CCCCCC" FontSize="13" />
        </Grid>

        <!-- messages -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer"
                      Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MessagesPanel" Margin="0,4,0,4" />
        </ScrollViewer>

        <!-- input -->
        <Border Grid.Row="2" Background="#252526" Padding="8">
            <TextBox x:Name="InputBox"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="120" MinHeight="24"
                     Background="#3C3C3C" Foreground="#CCCCCC"
                     CaretBrush="#CCCCCC" SelectionBrush="#0E639C"
                     FocusVisualStyle="{x:Null}" Padding="6,4"
                     BorderThickness="1"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13"
                     PreviewKeyDown="InputBox_PreviewKeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4A6785" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Border>

        <!-- overlay: shown when no API key is configured -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DisabledOverlay"
              Visibility="Collapsed" Background="#CC1E1E1E">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock x:Name="OverlayMessage"
                           Foreground="#FF4444" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />
                <TextBox x:Name="ApiKeyBox"
                         MaxLength="256"
                         Background="#3C3C3C" Foreground="#CCCCCC"
                         CaretBrush="#CCCCCC" SelectionBrush="#0E639C"
                         FocusVisualStyle="{x:Null}" Padding="6,4"
                         BorderThickness="1"
                         FontFamily="Consolas" FontSize="13"
                         PreviewKeyDown="ApiKeyBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#4A6785" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock x:Name="OverlayStatus"
                           Foreground="#666666" TextAlignment="Center"
                           Margin="0,8,0,0" FontSize="11">
                    Press Enter to submit
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- slash command completion popup -->
        <Popup x:Name="CompletionPopup"
               PlacementTarget="{Binding ElementName=InputBox}"
               Placement="Top" StaysOpen="True" AllowsTransparency="True">
            <Border Background="#2D2D2D" CornerRadius="4" Padding="2"
                    BorderBrush="#3F3F3F" BorderThickness="1">
                <ListBox x:Name="CompletionList" Focusable="False"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#CCCCCC" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#094771" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
